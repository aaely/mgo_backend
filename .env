# ── Neo4j ─────────────────────────────────────────────────────
# Used by AppState::new() in src/main.rs. Values below match the old
# hardcoded local-dev defaults — override for staging/prod.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Asdf123$

# ── Auth ──────────────────────────────────────────────────────
# Signing secret for JWTs (src/main.rs). Any long random string;
# rotate this per environment — it invalidates existing sessions.
JWT_SECRET=tO7E8uCjD5rXpQl0FhKwV2yMz4bJnAi9sGeR3kTzXvNmPuLsDq8W

# ── LDAP (login — src/ldap_auth.rs) ─────────────────────────────
# Login is LDAP-only now: /api/login binds a service account, searches for
# the submitted username, then rebinds as that user's DN with their password.
# All of these must be set or login fails outright.
LDAP_URL=ldaps://your-dc.corp.com:636
LDAP_DOMAIN=corp.com
LDAP_BIND_DN=CN=svc_app,OU=ServiceAccounts,DC=corp,DC=com
LDAP_BIND_PASSWORD=your_service_account_password
LDAP_BASE_DN=DC=corp,DC=com
LDAP_USER_SEARCH_BASE=OU=Users,DC=corp,DC=com

# AD group DN -> app role. A user must be in one of these to log in at all —
# no match means login is denied. If in more than one, highest wins
# (admin > manager > floater > mfu).
LDAP_GROUP_ADMIN=CN=MODMS-Admins,OU=Groups,DC=corp,DC=com
LDAP_GROUP_MANAGER=CN=MODMS-Managers,OU=Groups,DC=corp,DC=com
LDAP_GROUP_FLOATER=CN=MODMS-Floaters,OU=Groups,DC=corp,DC=com
LDAP_GROUP_MFU=CN=MODMS-MFU,OU=Groups,DC=corp,DC=com

# ── SMTP (email) ──────────────────────────────────────────────
# Used by send_email() in src/helpers.rs
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com

# Recipient for automated part/trailer alerts (src/services.rs).
# Leave unset to skip email alerts.
ALERT_EMAIL=alerts@example.com

# ── Twilio (SMS) ──────────────────────────────────────────────
# Used by send_sms() in src/helpers.rs — all three are required
# for SMS to work at all (send_sms errors out if any are missing).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555550100

# Recipient for automated SMS alerts (src/services.rs).
# Defaults to +18777804236 in code if unset.
ALERT_SMS=+15555550101
